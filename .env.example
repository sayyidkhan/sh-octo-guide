# Environment Variables for 13 Gold Diamonds Member Portal
# Copy this file to .env.local and fill in your actual values
#
# NEVER commit .env.local (it contains secrets)
# This .env.example file should be committed to Git as a template
#
# ---------------------------------------------------------------------------
# Quick Setup Guide
# ---------------------------------------------------------------------------
#
# 1. Firebase (Google Sign-in Authentication)
#    - Go to: https://console.firebase.google.com
#    - Create/Select your project → Project Settings → General → Your apps
#    - Add a Web App (</>) if you don't have one
#    - Copy the Firebase config values to VITE_FIREBASE_* below
#    - Enable Google provider: Authentication → Sign-in method → Google
#
# 2. Firebase Admin SDK (server-side user management)
#    - Go to: Firebase Console → Project Settings → Service accounts
#    - Click "Generate new private key" (downloads JSON)
#    - Map JSON fields to FIREBASE_ADMIN_* variables below
#    - CRITICAL: Keep private_key as single line with \n characters
#
# 3. Google Sheets API (content source)
#    - Go to: https://console.cloud.google.com
#    - Enable "Google Sheets API"
#    - Create Service Account → Keys → Add key → JSON (download)
#    - Map JSON fields to GOOGLE_SHEETS_* variables
#    - Share your Google Sheet with the service account email (Viewer access)
#
# 4. Cache TTL Settings (optional - defaults work for weekly refresh)
#    - Adjust SHEETS_CDN_TTL_SECONDS if you want different refresh timing

###############################################################################
# App Configuration
###############################################################################

# Bootstrap admin emails (comma-separated)
# These users get admin access on first login
ADMIN_EMAILS=admin@example.com,youremail@example.com

###############################################################################
# CDN Cache Configuration
###############################################################################

# How long CDN caches Google Sheets data (in seconds)
# Default: 604800 seconds = 7 days (weekly refresh)
# Options: 86400 (daily), 3600 (hourly), 604800 (weekly)
SHEETS_CDN_TTL_SECONDS=604800

# Stale-while-revalidate window (in seconds)
# CDN serves stale content while fetching fresh data in background
# Default: 86400 seconds = 1 day
SHEETS_CDN_STALE_WHILE_REVALIDATE_SECONDS=86400

###############################################################################
# Firebase Client SDK (Browser-side)
# These are exposed to the browser (VITE_ prefix)
###############################################################################

# Get these from: Firebase Console → Project Settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional: Only needed if using Firebase Storage
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Optional: Rarely needed
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# Optional: Only if you enable Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

###############################################################################
# Firebase Admin SDK (Server-side only - NEVER expose to browser)
# Used by Vercel Serverless Functions for admin operations
###############################################################################

# Get these from the service account JSON file
# Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# CRITICAL: Store as single line with literal \n characters
# Format: "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

###############################################################################
# Google Sheets API (Server-side only - content source)
###############################################################################

# Your Google Sheet ID (from the URL)
# Example URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Copy the SPREADSHEET_ID part
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Service account credentials (from service account JSON)
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Store as single line with literal \n characters (same format as Firebase Admin)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: Custom sheet ranges (update to match your sheet tab names)
# Defaults shown below
GOOGLE_SHEETS_RANGE_TESTIMONIALS=Testimonials!A:Z
GOOGLE_SHEETS_RANGE_CONTENT_LIBRARY=ContentLibrary!A:Z
GOOGLE_SHEETS_RANGE_ACCESS=Access!A:Z

###############################################################################
# Notes
###############################################################################
#
# Security Reminders:
# - Never commit .env.local to Git
# - All VITE_ variables are exposed to the browser
# - Never prefix sensitive keys (Admin SDK, Sheets API) with VITE_
# - Rotate keys immediately if accidentally exposed
#
# For Vercel Deployment:
# - Add all these variables to: Project Settings → Environment Variables
# - Set appropriate scopes: Production, Preview, Development
# - Use different values for Production vs Preview if needed
#
# Testing Locally:
# - Copy this to .env.local
# - Run: npm run dev
# - Visit: http://localhost:5173
#
