# Rename this file to `.env.local` for local development.
#
# Never commit real secrets (especially private keys).
# Vite only exposes variables prefixed with `VITE_` to the browser.
# Serverless/API code (e.g., Vercel Functions) can use non-VITE variables.
#
# ---------------------------------------------------------------------------
# Quick setup guide (Firebase + Sheets + CDN caching)
# ---------------------------------------------------------------------------
#
# 1) Firebase (Google Sign-in)
# - Go to Firebase Console → Create/Select project
# - Project settings (gear icon) → General → "Your apps"
#   - Create a Web App (</>) if you don't have one yet
#   - Copy the config values into the VITE_FIREBASE_* vars below
# - Authentication → Sign-in method → enable "Google"
#
# 2) Firebase Admin (server-side admin actions)
# - Firebase Console → Project settings → Service accounts
# - Generate a new private key (JSON)
# - Set:
#   - FIREBASE_ADMIN_PROJECT_ID (from JSON: project_id)
#   - FIREBASE_ADMIN_CLIENT_EMAIL (from JSON: client_email)
#   - FIREBASE_ADMIN_PRIVATE_KEY (from JSON: private_key)
# - IMPORTANT: keep it on one line with \n, like:
#   "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# 3) Google Sheets (source of truth for content)
# - Google Cloud Console → create/select project (can be same as Firebase project)
# - Enable "Google Sheets API"
# - Create a Service Account + key (JSON)
# - Share your Google Sheet with the service account email (Viewer or Editor)
# - Set GOOGLE_SHEETS_* from the service account JSON
#
# 4) CDN Cache Settings (optional - defaults provided)
# - SHEETS_CDN_TTL_SECONDS: how long CDN caches content (default: 7 days)
# - SHEETS_CDN_STALE_WHILE_REVALIDATE_SECONDS: stale cache while refreshing (default: 1 day)

###############################################################################
# App / Environment
###############################################################################

# Optional: bootstrap admin emails (comma-separated)
# Used to grant initial admin access before admin roles/blacklists are fully set up.
ADMIN_EMAILS=admin@example.com

# CDN Cache TTL (seconds) - how long to cache Google Sheets data
# Default: 604800 (7 days)
SHEETS_CDN_TTL_SECONDS=604800

# Stale-while-revalidate window (seconds) - serve stale cache while refreshing
# Default: 86400 (1 day)
SHEETS_CDN_STALE_WHILE_REVALIDATE_SECONDS=86400

###############################################################################
# Firebase (Client-side) — used by the Vite/React app
###############################################################################

# Where to find these:
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional (only if you use Firebase Storage)
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Optional (rarely needed unless you use other Firebase products)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# Optional (only if you enable Analytics)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

###############################################################################
# Firebase Admin (Server-side only) — used by Vercel Serverless Functions
# For actions like: disabling users, setting roles/custom claims, etc.
###############################################################################

# How to get these values:
# - Firebase Console → Project settings → Service accounts
# - Click "Generate new private key" (downloads a JSON file)
# - Map JSON fields to env vars:
#   - FIREBASE_ADMIN_PROJECT_ID     = project_id
#   - FIREBASE_ADMIN_CLIENT_EMAIL   = client_email
#   - FIREBASE_ADMIN_PRIVATE_KEY    = private_key
# - IMPORTANT: store the private key as a single line with literal \n characters.
#   Many runtimes expect:
#   "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com

# IMPORTANT:
# - Keep the exact formatting required by your runtime.
# - Many setups store this as a single line with literal \n characters.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

###############################################################################
# Google Sheets (Server-side only) — used to sync content into cache
###############################################################################

# How to get these values (Service Account approach - recommended):
# 1) In Google Cloud Console (use the same project as Firebase or any project you control):
#    - APIs & Services → Library → enable "Google Sheets API"
# 2) Create a Service Account + JSON key:
#    - IAM & Admin → Service Accounts → Create service account
#    - Open the service account → Keys → Add key → Create new key → JSON (download)
# 3) Set env vars from the downloaded JSON:
#    - GOOGLE_SHEETS_CLIENT_EMAIL  = client_email
#    - GOOGLE_SHEETS_PRIVATE_KEY   = private_key
#      (store it as a single line with literal \n characters, same pattern as Firebase Admin)
# 4) Spreadsheet ID:
#    - Open the Google Sheet URL and copy the ID between `/d/` and `/edit`
#      Example: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# 5) Share the Sheet with the service account email:
#    - In Google Sheets → Share → add the service account email (Viewer is enough for read-only)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: ranges (update to match your sheet tabs/columns)
GOOGLE_SHEETS_RANGE_TESTIMONIALS=Testimonials!A:Z
GOOGLE_SHEETS_RANGE_CONTENT_LIBRARY=ContentLibrary!A:Z
GOOGLE_SHEETS_RANGE_ACCESS=Access!A:Z
